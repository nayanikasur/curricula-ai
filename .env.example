# Any OpenAI-compatible chat API works. All options below are free.

# Option A (default, and what to use on Netlify): Groq free tier, no card needed.
# Create a key at https://console.groq.com/keys
LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# Option B: fully offline with Ollama (https://ollama.com), local development only.
#   ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
